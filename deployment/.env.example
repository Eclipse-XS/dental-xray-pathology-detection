DENTEX_ENVIRONMENT=development
DENTEX_LOG_LEVEL=INFO
DENTEX_BACKEND=pytorch
DENTEX_PROJECT_ROOT=/project
DENTEX_CHECKPOINT_PATH=/project/artifacts/refinement/fcos/F_final_fcos_tuned/best.pth
DENTEX_MODEL_METADATA_PATH=/project/artifacts/refinement/fcos/selected_final_model.json
DENTEX_ONNX_MODEL_PATH=/project/deployment/models/final_fcos_768.onnx
DENTEX_DEVICE=cpu
DENTEX_IMAGE_SIZE=768
DENTEX_CONFIDENCE_THRESHOLD=0.5
DENTEX_MAX_UPLOAD_BYTES=15728640
DENTEX_MIN_IMAGE_DIMENSION=64
DENTEX_MAX_IMAGE_DIMENSION=8192
DENTEX_DATABASE_URL=postgresql+psycopg://dentex:change-me@postgres:5432/dentex
DENTEX_PERSIST_PREDICTIONS=true
DENTEX_STORAGE_BACKEND=local
DENTEX_STORAGE_PATH=/runtime/uploads
DENTEX_MINIO_ENDPOINT=minio:9000
DENTEX_MINIO_ACCESS_KEY=dentex
DENTEX_MINIO_SECRET_KEY=change-me
DENTEX_MINIO_BUCKET=dentex-predictions
DENTEX_PROMETHEUS_ENABLED=true
POSTGRES_USER=dentex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dentex
MINIO_ROOT_USER=dentex
MINIO_ROOT_PASSWORD=change-me
